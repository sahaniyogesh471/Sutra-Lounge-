# Security Headers for all responses
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://supabase.com https://*.supabase.co;
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Permitted-Cross-Domain-Policies: none

# Enable HTTP/2 Server Push for critical assets
/*
  Link: </assets/vendor-react-*.js>; rel=preload; as=script, </assets/index-*.js>; rel=preload; as=script

# Asset caching - immutable for versioned files with hash in filename
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  ETag: W/"versioned"

# Image caching - long TTL since we use versioned names
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

# WebP image optimization with fallback
/images/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

# HTML files - don't cache, always validate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  ETag: W/"dynamic"

# JS chunks - immutable once built with hash
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# CSS chunks - immutable once built with hash
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Main HTML entry - no cache to detect new deployments
/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/html; charset=utf-8

# Manifest and service worker
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# API/JSON responses
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Gzip compression for text assets
/assets/*.js
  Content-Encoding: gzip

/assets/*.css
  Content-Encoding: gzip

# CORS headers for API
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Access-Control-Max-Age: 86400
